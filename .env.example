# Copia este fichero a .env y rellena los valores.
#   cp .env.example .env
#
# El .env real no se sube al repositorio (esta en .gitignore); este ejemplo si,
# para que quien clone el proyecto sepa que variables hacen falta.

# --- Supabase (obligatorias) -------------------------------------------------
# Panel de Supabase -> Project Settings -> API.
# La clave es la publica (anon). Esta pensada para viajar al navegador: lo que
# protege los datos son las politicas RLS, no la clave. La clave de servicio
# NUNCA debe aparecer aqui ni en el codigo.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_KEY=tu-clave-anon

# URL a la que vuelve Google después de autenticar (recomendado en Vercel).
# En Vercel añade VITE_SITE_URL en Production con tu dominio público.
VITE_SITE_URL=https://tu-dominio.vercel.app
# Para previews también puedes definir VITE_VERCEL_URL con el hostname del preview.
VITE_VERCEL_URL=

# --- Desarrollo (opcionales) -------------------------------------------------
# Las dos vienen activadas por defecto en `npm run dev` y no existen en
# `npm run build`: el empaquetador las elimina del paquete de produccion.

# Panel DEV abajo a la derecha, con la sesion de prueba.
# Ponlo a false para desarrollar sin el.
VITE_DEV_LOGIN=true

# Anuncios de ejemplo mientras dura la sesion de prueba.
# Ponlo a false para que ni siquiera la sesion de prueba los cargue.
VITE_USE_MOCK_DATA=true
